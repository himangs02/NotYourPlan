# EventFlow Environment Configuration Example
# Copy to .env and fill in your actual credentials.
# NEVER commit real credentials to version control.

# Database Configuration (YugabyteDB / PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://yugabyte:yugabyte@localhost:5433/yugabyte

# Google Gemini API Key (Optional: structured fallback compiler used if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Meko Context Layer Credentials (Optional: YugabyteDB-backed context table used if unset)
MEKO_API_KEY=your_meko_api_key_here
MEKO_ENDPOINT=https://api.meko.yugabyte.com/v1

# Simulation Configuration
SUMO_BINARY=sumo
SIMULATION_STEP_LENGTH=1.0

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

